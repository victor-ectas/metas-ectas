# Copie para .env e preencha. O .env nunca vai para o repositório.

# --- API e jobs ---
# development | test | production
NODE_ENV=development
PORT_API=3000

# --- Banco de dados ---
# Aplicação (API e jobs): usuário com privilégios mínimos, só lê e escreve dados.
DATABASE_URL=postgresql://metas_app:SENHA_APP@localhost:5433/metas
# Migrações e seed (Prisma CLI): dono do esquema.
DATABASE_URL_MIGRACAO=postgresql://metas_owner:SENHA_OWNER@localhost:5433/metas
# Testes de integração: banco separado, recriado só pelas migrações.
DATABASE_URL_TESTE=postgresql://metas_owner:SENHA_OWNER@localhost:5433/metas_teste

# Só desenvolvimento: PostgreSQL no Docker (docker-compose.yml). Use senhas sem caracteres
# especiais de URL (@ : / ? #), ou codifique-as nas URLs acima.
POSTGRES_PORTA=5433
POSTGRES_PASSWORD=
METAS_OWNER_PASSWORD=
METAS_APP_PASSWORD=

# Entra ID (registro do aplicativo; tokens v2). Obrigatórios, exceto com AUTH_DEV=true.
# ENTRA_TENANT_ID: ID do diretório (GUID).
ENTRA_TENANT_ID=
# Audiências aceitas no token, separadas por vírgula. Em tokens v2, `aud` traz o ID do aplicativo
# (GUID) que expõe o escopo da API; inclua-o junto com o URI. Ex.: api://metas,<GUID do aplicativo>
ENTRA_API_AUDIENCE=api://metas
ENTRA_SPA_CLIENT_ID=

# Origem permitida no CORS (endereço do front-end)
WEB_ORIGIN=http://localhost:5173

# Modo DEV de autenticação: só com NODE_ENV=development (a API não inicia com AUTH_DEV=true em
# test ou production). Sem token: entra como AUTH_DEV_EMAIL, que precisa existir no banco (o
# Administrador do seed serve). O cabeçalho X-Usuario-Dev: <e-mail> troca o usuário simulado.
AUTH_DEV=false
AUTH_DEV_EMAIL=

# Relógio fixo das regras de fechamento (ISO com fuso). Só para os testes ponta a ponta, que o
# definem sozinhos; a API não inicia com ele fora de NODE_ENV=development. Deixe vazio.
RELOGIO_FIXO=

# Seed de desenvolvimento: e-mail do Administrador inicial
SEED_ADMIN_EMAIL=

# Fuso das regras de fechamento
TZ_REGRAS=America/Sao_Paulo
LOG_LEVEL=info
# Requisições de escrita (POST/PUT/PATCH/DELETE) por minuto e por IP. Padrão: 120.
LIMITE_ESCRITA_POR_MINUTO=120

# Fase 2: pasta das evidências, fora do site
EVIDENCIAS_DIR=D:\metas-dados\evidencias

# --- Front-end (Vite) ---
# Embutidas no build: nada aqui é segredo. Registro do aplicativo SPA no Entra ID (redirect
# http://localhost:5173/ em desenvolvimento e https://<host interno>/ em produção).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_API_SCOPE=api://metas/acesso
# Em produção a API fica no mesmo endereço do site (IIS); vazio = /api/v1.
VITE_API_URL=http://localhost:3000/api/v1
# Modo DEV na web (usuário simulado). Só vale no `pnpm dev`; o build de produção ignora.
VITE_AUTH_DEV=false
