{
  "name": "@metas/motor",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de cálculo: fórmulas, cálculo e calendário (sem banco, sem HTTP)",
  "type": "module",
  "exports": {
    ".": {
      "@metas/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@metas/tipos": "workspace:*"
  }
}
