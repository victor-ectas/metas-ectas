# Configuração da API em produção (docs/deploy-windows.md, passo 6).
#
# Copie para D:\metas\config\api.env e preencha. Os serviços metas-api e metas-jobs leem este
# arquivo com `node --env-file` (os jobs usam só NODE_ENV, DATABASE_URL e LOG_LEVEL). Só Administradores e a conta do serviço podem ler a pasta config
# (instalar-servico.ps1 ajusta as permissões). Nunca coloque este arquivo no repositório.

NODE_ENV=production
PORT_API=3000

# Usuário da aplicação (privilégios mínimos). Senha sem @ : / ? # ou codificada na URL.
DATABASE_URL=postgresql://metas_app:SENHA_APP@localhost:5432/metas

# Endereço do site, exatamente como os usuários acessam (CORS).
WEB_ORIGIN=https://metas.ectas.local

# Entra ID (tokens v2): ID do diretório e audiências aceitas (URI e ID do aplicativo da API).
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=api://metas,GUID_DO_APLICATIVO

# Nunca true em produção: a API se recusa a iniciar.
AUTH_DEV=false

LOG_LEVEL=info
LIMITE_ESCRITA_POR_MINUTO=120
