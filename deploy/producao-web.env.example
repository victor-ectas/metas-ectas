# Variáveis do front-end embutidas no build de produção (deploy/empacotar.ps1).
# Copie para deploy/producao-web.env (fora do git) e preencha. Nada aqui é segredo: tudo vai
# para o JavaScript que o navegador baixa.

# Registro do aplicativo SPA no Entra ID (redirect: https://<endereço do site>/).
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Escopo exposto pela API.
VITE_API_SCOPE=api://metas/acesso
