{
  "name": "@metas/jobs",
  "version": "0.0.0",
  "private": true,
  "description": "Serviço de jobs (pg-boss): rotina diária do fechamento",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch --conditions=@metas/source src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@metas/motor": "workspace:*",
    "@metas/prisma": "workspace:*",
    "luxon": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
